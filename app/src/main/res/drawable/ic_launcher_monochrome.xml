<!-- 白い熊 人造人間 (themed-icon monochrome layer): the droid-head + download-arrow mark traced as stroke-only line-art in the
     house yellow. Path data is shared with design/shiroikuma-jinsoningen-icon.svg; only the
     framing differs.

     An adaptive icon is cropped by the launcher's mask, so its artwork is meant to FILL the
     central 72x72 safe zone rather than sit inside it — that is why an icon inset within the
     safe zone renders visibly smaller than its neighbours in a launcher or file list. The
     artwork measures 236x289 in the shared 512 coordinate space, so:

         scale = 72 / 289 = 0.2491   (289 tall becomes exactly the 72 safe zone)
         the artwork centre (256, 241.5) is placed at the icon centre (54, 54):
         translateX = 54 - 0.2491 * 256   = -9.77
         translateY = 54 - 0.2491 * 241.5 = -6.16

     Width lands at 236 * 0.2491 = 58.8 of the 72, so the mask never clips it sideways. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.2491"
        android:scaleY="0.2491"
        android:translateX="-9.77"
        android:translateY="-6.16">
        <!-- droid head: the dome, a 242 degree sweep opening downward -->
        <path
            android:pathData="M155,293 A118,118,0,1,1,357,293"
            android:fillColor="#00000000"
            android:strokeColor="#FF000000"
            android:strokeWidth="34"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- antennae -->
        <path
            android:pathData="M365,117 L341,140"
            android:fillColor="#00000000"
            android:strokeColor="#FF000000"
            android:strokeWidth="18"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M147,117 L171,140"
            android:fillColor="#00000000"
            android:strokeColor="#FF000000"
            android:strokeWidth="18"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- eyes -->
        <path
            android:pathData="M208,204 a12,12,0,1,0,24,0 a12,12,0,1,0,-24,0 z"
            android:fillColor="#FF000000" />
        <path
            android:pathData="M280,204 a12,12,0,1,0,24,0 a12,12,0,1,0,-24,0 z"
            android:fillColor="#FF000000" />
        <!-- download arrow: stem + chevron, so every end reads as a rounded tip -->
        <path
            android:pathData="M256,280 L256,373"
            android:fillColor="#00000000"
            android:strokeColor="#FF000000"
            android:strokeWidth="26"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M213,327 L256,373 L299,327"
            android:fillColor="#00000000"
            android:strokeColor="#FF000000"
            android:strokeWidth="26"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
