<!-- 白い熊 人造人間 (themed-icon monochrome layer): the droid-head + download-arrow mark traced as stroke-only line-art in the
     house yellow. Source of truth: design/shiroikuma-jinsoningen-icon.svg, whose 512x512 canvas
     maps onto the central 72x72 safe zone of this 108x108 adaptive viewport
     (scale 72/512 = 0.140625, offset 18 + the design's own 15px vertical centring). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.140625"
        android:scaleY="0.140625"
        android:translateX="18"
        android:translateY="20.109375">
        <!-- droid head: the dome, a 242 degree sweep opening downward -->
        <path
            android:pathData="M155,293 A118,118,0,1,1,357,293"
            android:fillColor="#00000000"
            android:strokeColor="#FF000000"
            android:strokeWidth="34"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- antennae -->
        <path
            android:pathData="M365,117 L341,140"
            android:fillColor="#00000000"
            android:strokeColor="#FF000000"
            android:strokeWidth="18"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M147,117 L171,140"
            android:fillColor="#00000000"
            android:strokeColor="#FF000000"
            android:strokeWidth="18"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- eyes -->
        <path
            android:pathData="M208,204 a12,12,0,1,0,24,0 a12,12,0,1,0,-24,0 z"
            android:fillColor="#FF000000" />
        <path
            android:pathData="M280,204 a12,12,0,1,0,24,0 a12,12,0,1,0,-24,0 z"
            android:fillColor="#FF000000" />
        <!-- download arrow: stem + chevron, so every end reads as a rounded tip -->
        <path
            android:pathData="M256,280 L256,373"
            android:fillColor="#00000000"
            android:strokeColor="#FF000000"
            android:strokeWidth="26"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M213,327 L256,373 L299,327"
            android:fillColor="#00000000"
            android:strokeColor="#FF000000"
            android:strokeWidth="26"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
