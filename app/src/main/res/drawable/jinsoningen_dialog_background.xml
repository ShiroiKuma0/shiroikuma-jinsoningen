<?xml version="1.0" encoding="utf-8"?>
<!-- 白い熊 人造人間 fork: the ground under every legacy MaterialAlertDialog — black fill with the
     house yellow edge. Without a stroke a black dialog on a black page has no edge at all and
     reads as loose text floating over what it covers. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/jinsoningen_black" />
    <stroke
        android:width="2dp"
        android:color="@color/jinsoningen_yellow" />
    <corners android:radius="@dimen/shape_large_corner" />
</shape>
